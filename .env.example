STATS_ENV=development
DATA_MODE=dynamo-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
TABLE_NAME=stats-local-fixtures
SOURCE_REGION=us-east-2
GOOGLE_CLIENT_ID=REPLACE_WITH_STATS_WEB_CLIENT.apps.googleusercontent.com
# Real Google sign-in is required with DATA_MODE=dynamo-local or cloud.
# Explicit isolated synthetic demo instead: npm run demo (no .env needed).
# Cloud development: DATA_MODE=cloud, omit endpoint, set CLOUD_DEV_CONFIRMED=true,
# and select an explicit Puncher DEVELOPMENT table and read-only AWS profile.
