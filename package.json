{
  "name": "stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:ui\"",
    "demo": "concurrently -k \"npm run demo:api\" \"npm run dev:ui\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx service/local.ts",
    "demo:api": "node --import tsx service/local.ts --demo",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/bundle.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:db": "node --env-file-if-exists=.env --import tsx --test tests/dynamo.integration.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/local-db.ts",
    "cdk:synth": "cdk synth --app \"npx tsx infra/app.ts\"",
    "cdk:deploy": "cdk deploy --app \"npx tsx infra/app.ts\" --all",
    "check": "npm run build && npm test && npm run cdk:synth -- -c validation=true",
    "format": "prettier --write \"{service,ui/src,infra,scripts,tests}/**/*.{ts,tsx,css}\" \"*.{json,ts}\""
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "@fontsource/figtree": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "ajv": "^8.20.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "google-auth-library": "^11.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "aws-cdk": "^2.1147.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
